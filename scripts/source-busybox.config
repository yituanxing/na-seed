# Shared, intentionally limited 1.37.0 Kconfig for all three ISAs.
# Edit this when a new OS capability/workload is selected, never silently
# use a distro-dependent default or an architecture-dependent defconfig.
CONFIG_BUSYBOX=y
CONFIG_STATIC=y
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_ECHO=y
CONFIG_CAT=y
CONFIG_LS=y
CONFIG_WC=y
CONFIG_HEAD=y
CONFIG_GREP=y
CONFIG_PWD=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_RM=y
CONFIG_TRUE=y
CONFIG_PRINTF=y
CONFIG_SLEEP=y
